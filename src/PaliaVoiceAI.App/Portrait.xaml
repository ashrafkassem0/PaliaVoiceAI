<UserControl x:Class="PaliaVoiceAI.App.Portrait"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PaliaVoiceAI.App">
    <Grid>
        <Ellipse Fill="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=local:Portrait}}"/>
        <Ellipse x:Name="Hair" Fill="{Binding HairBrush, RelativeSource={RelativeSource AncestorType=local:Portrait}}" Margin="8,0,8,14"/>
        <Ellipse x:Name="Bun" Fill="{Binding HairBrush, RelativeSource={RelativeSource AncestorType=local:Portrait}}" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,6,0" Visibility="Collapsed"/>
        <Ellipse Fill="{Binding SkinBrush, RelativeSource={RelativeSource AncestorType=local:Portrait}}" Width="58" Height="58" VerticalAlignment="Center" Margin="0,6,0,0"/>
        <Ellipse Width="6" Height="7" Fill="#2A2038" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-16,2,0,0"/>
        <Ellipse Width="6" Height="7" Fill="#2A2038" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,2,0,0"/>
        <Ellipse Fill="{Binding ShirtBrush, RelativeSource={RelativeSource AncestorType=local:Portrait}}" Height="14" VerticalAlignment="Bottom" Margin="16,0,16,1"/>
    </Grid>
</UserControl>
