<Window x:Class="PaliaVoiceAI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Palia Voice AI — Phase 1" Height="650" Width="900"
        MinHeight="560" MinWidth="760" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Palia Voice AI" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Phase 1 · Local TTS pipeline and benchmark harness" Foreground="Gray" Margin="0,4,0,16"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Backend" Margin="0,0,0,5"/>
                <ComboBox x:Name="BackendBox" SelectedIndex="0"><ComboBoxItem Content="Mock (pipeline test)"/><ComboBoxItem Content="CPU (Kokoro - pending)"/><ComboBoxItem Content="CUDA (Kokoro - pending)"/></ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="Voice ID" Margin="0,0,0,5"/>
                <ComboBox x:Name="VoiceBox" SelectedIndex="0"><ComboBoxItem Content="af_bella"/><ComboBoxItem Content="af_nicole"/><ComboBoxItem Content="am_michael"/><ComboBoxItem Content="bm_george"/></ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="CPU Threads" Margin="0,0,0,5"/>
                <ComboBox x:Name="ThreadsBox" SelectedIndex="1"><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/></ComboBox>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="English dialogue" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="DialogueBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="16" Padding="12" Text="Hello! Welcome to Kilima Village. How can I help you today?"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,8">
                <Button x:Name="GenerateButton" Content="Generate / Benchmark" Width="170" Height="36" Click="Generate_Click"/>
                <Button Content="Play" Width="80" Height="36" Margin="8,0,0,0" Click="Play_Click"/>
                <Button Content="Stop" Width="80" Height="36" Margin="8,0,0,0" Click="Stop_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Row="3" Text="Ready. Mock mode produces silence; it only verifies the pipeline." Foreground="DarkSlateGray" TextWrapping="Wrap"/>
        </Grid>
        <DataGrid x:Name="ResultsGrid" Grid.Row="3" Margin="0,58,0,0" Height="130" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</Window>
