<Window x:Class="PaliaVoiceAI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PaliaVoiceAI.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Palia Voice" Height="820" Width="1280"
        MinHeight="700" MinWidth="1100" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="#12101C"
        Foreground="#F4F1FF" FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="VoiceItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="176"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="#1B1730" BorderBrush="#2C2748" BorderThickness="1" CornerRadius="18" Padding="12,14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#7C5CFF"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#241C3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeartButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#0E0C18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,20,0,18">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#7C5CFF" Margin="0,0,10,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE720;" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                    </Border>
                    <TextBlock Text="Palia Voice" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="0,8,0,0">
                    <RadioButton x:Name="NavVoices" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True" Checked="Nav_Checked" Tag="voices">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE720;" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="VoiceBox"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked" Tag="sound">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Soundboard"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked" Tag="studio">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Voicestudio"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked" Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="22,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Height="38" VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Stretch" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox x:Name="SearchBox" Padding="36,0,12,0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="#8E88A8" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchHint" Text="Search" Foreground="#8E88A8" VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#6D4DFF" CornerRadius="16" Padding="14,7" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="On this PC" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="VoicePage" Grid.Row="1" Margin="22,8,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,12">
                            <RadioButton Style="{StaticResource FilterTab}" GroupName="Filter" Content="All" IsChecked="True" Checked="Filter_Checked" Tag="all"/>
                            <RadioButton Style="{StaticResource FilterTab}" GroupName="Filter" Content="Women" Checked="Filter_Checked" Tag="women"/>
                            <RadioButton Style="{StaticResource FilterTab}" GroupName="Filter" Content="Men" Checked="Filter_Checked" Tag="men"/>
                            <RadioButton Style="{StaticResource FilterTab}" GroupName="Filter" Content="British" Checked="Filter_Checked" Tag="british"/>
                            <RadioButton Style="{StaticResource FilterTab}" GroupName="Filter" Content="Favorite" Checked="Filter_Checked" Tag="favorite"/>
                            <RadioButton Style="{StaticResource FilterTab}" GroupName="Filter" Content="Custom" Checked="Filter_Checked" Tag="custom"/>
                        </StackPanel>
                        <TextBlock x:Name="FilterTitle" Text="All" FontSize="20" FontWeight="SemiBold" Margin="8,0,0,8"/>
                    </StackPanel>
                    <ListBox x:Name="VoiceList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource VoiceItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="VoiceList_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="148">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid Width="74" Height="74" HorizontalAlignment="Center">
                                            <local:Portrait Width="74" Height="74" Visibility="{Binding PortraitVisibility}"
                                                            AccentBrush="{Binding Accent}" HairBrush="{Binding Hair}" SkinBrush="{Binding Skin}" ShirtBrush="{Binding Shirt}" Variant="{Binding Variant}"/>
                                            <Ellipse Width="74" Height="74" Visibility="{Binding AvatarVisibility}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <Button Style="{StaticResource HeartButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Favorite_Click" Tag="{Binding}">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding HeartGlyph}" FontSize="14" Foreground="{Binding HeartBrush}"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,8,0,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Text="{Binding VoiceLabel}" HorizontalAlignment="Center" Foreground="#9B94B8" FontSize="12" Margin="0,2,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <Border Grid.Column="1" Background="#161228" CornerRadius="20" Padding="20" Margin="8,0,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                            <Grid Width="96" Height="96" HorizontalAlignment="Center">
                                <local:Portrait x:Name="DetailPortrait" Width="96" Height="96"/>
                                <Ellipse x:Name="DetailAvatar" Width="96" Height="96" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="DetailName" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock x:Name="DetailRole" Foreground="#9B94B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="Kokoro voice, not the original actor" Foreground="#6E6888" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,14"/>
                        </StackPanel>
                        <Button x:Name="PreviewVoiceButton" DockPanel.Dock="Bottom" Width="84" Height="84" Margin="0,16,0,8" HorizontalAlignment="Center" Click="PreviewVoice_Click" ToolTip="Play this voice">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse Fill="#7C5CFF" Opacity="0.28" Margin="-10"/>
                                        <Ellipse Fill="#8B6CFF"/>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE720;" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="Assigned voice" Foreground="#9B94B8" FontSize="12" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ProfileVoiceBox" SelectionChanged="ProfileVoiceBox_SelectionChanged"/>
                            <TextBlock Text="Pace" Foreground="#9B94B8" FontSize="12" Margin="0,14,0,6"/>
                            <Slider x:Name="PaceSlider" Minimum="0.85" Maximum="1.15" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="PaceSlider_ValueChanged"/>
                            <TextBlock x:Name="DetailIntro" TextWrapping="Wrap" Foreground="#C9C3E0" Margin="0,14,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid x:Name="SoundPage" Grid.Row="1" Margin="28,12,28,12" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Soundboard" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="SoundEmpty" DockPanel.Dock="Top" Text="Lines you preview or capture show up here. Double-click one to play it again." Foreground="#9B94B8" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <ListBox x:Name="SoundList" Background="Transparent" BorderThickness="0" DisplayMemberPath="Caption"/>
                </DockPanel>
            </Grid>

            <Grid x:Name="StudioPage" Grid.Row="1" Margin="28,12,28,12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="160"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Voicestudio" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Backend" Foreground="#9B94B8" Margin="0,0,0,5"/>
                        <ComboBox x:Name="BackendBox" SelectedIndex="1" SelectionChanged="EngineChoice_Changed">
                            <ComboBoxItem Content="Mock (silent pipeline test)"/>
                            <ComboBoxItem Content="CPU (Kokoro)"/>
                            <ComboBoxItem Content="CUDA (Kokoro, falls back to CPU)"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Voice" Foreground="#9B94B8" Margin="0,0,0,5"/>
                        <ComboBox x:Name="VoiceBox" SelectionChanged="EngineChoice_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="CPU threads" Foreground="#9B94B8" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ThreadsBox" SelectedIndex="1" SelectionChanged="EngineChoice_Changed">
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="DialogueBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="16"
                         Text="Hello! Welcome to Kilima Village. How can I help you today?"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,8">
                    <Button x:Name="GenerateButton" Style="{StaticResource QuietButton}" Content="Generate" MinWidth="120" Click="Generate_Click"/>
                    <Button Style="{StaticResource QuietButton}" Content="Play" MinWidth="80" Margin="8,0,0,0" Click="Play_Click"/>
                    <Button Style="{StaticResource QuietButton}" Content="Stop" MinWidth="80" Margin="8,0,0,0" Click="Stop_Click"/>
                </StackPanel>
                <DataGrid x:Name="ResultsGrid" Grid.Row="4" AutoGenerateColumns="True" IsReadOnly="True"/>
            </Grid>

            <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Margin="28,12,28,12" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#9B94B8" Margin="0,8,0,14"
                               Text="Reads the dialogue region with Windows OCR. A line is accepted only after it stays still. When Apply voice is on, a known name uses that villager's voice. A line with no name uses Unknown."/>
                    <TextBlock Text="Playback" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,8"/>
                    <DockPanel Margin="0,0,0,6" LastChildFill="True">
                        <TextBlock x:Name="VolumeReadout" DockPanel.Dock="Right" Width="52" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#F4F1FF" Text="100%"/>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#9B94B8" Margin="0,0,0,8"
                               Text="This volume is used for preview, Generate, and captured lines. Backend, CPU threads, and the Voicestudio voice are restored on the next launch."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#9B94B8" Margin="0,0,0,16"
                               Text="Errors and timings are written to %LOCALAPPDATA%\PaliaVoiceAI\logs. The log stores the error type and the timing. It does not store the dialogue line."/>
                    <CheckBox x:Name="UseGameWindowBox" Content="Capture the Palia window" IsChecked="True" Foreground="#F4F1FF" Checked="CaptureMode_Changed" Unchecked="CaptureMode_Changed"/>
                    <TextBlock x:Name="GameWindowStatus" Margin="0,8,0,0" TextWrapping="Wrap" Text="Palia has not been looked up yet."/>
                    <TextBlock x:Name="RegionHint" Margin="0,4,0,0" Foreground="#9B94B8" Text="Region is relative to the Palia client area, in pixels."/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="DetectButton" Style="{StaticResource QuietButton}" Content="Find Palia" Click="Detect_Click"/>
                        <Button x:Name="SuggestButton" Style="{StaticResource QuietButton}" Content="Suggest region" Margin="8,0,0,0" Click="Suggest_Click"/>
                    </StackPanel>
                    <UniformGrid Columns="7" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="X" Foreground="#9B94B8"/><TextBox x:Name="RegionX" Margin="0,4,0,0" Text="131"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Y" Foreground="#9B94B8"/><TextBox x:Name="RegionY" Margin="0,4,0,0" Text="688"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Width" Foreground="#9B94B8"/><TextBox x:Name="RegionWidth" Margin="0,4,0,0" Text="975"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Height" Foreground="#9B94B8"/><TextBox x:Name="RegionHeight" Margin="0,4,0,0" Text="438"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Poll ms" Foreground="#9B94B8"/><TextBox x:Name="PollIntervalBox" Margin="0,4,0,0" Text="400"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Stable reads" Foreground="#9B94B8"/><TextBox x:Name="StableReadsBox" Margin="0,4,0,0" Text="2"/></StackPanel>
                        <StackPanel><TextBlock Text="Duplicate sec" Foreground="#9B94B8"/><TextBox x:Name="DuplicateWindowBox" Margin="0,4,0,0" Text="8"/></StackPanel>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="PreviewButton" Style="{StaticResource QuietButton}" Content="Preview once" Click="Preview_Click"/>
                        <Button x:Name="MonitorButton" Style="{StaticResource QuietButton}" Content="Start monitoring" Margin="8,0,0,0" Click="Monitor_Click"/>
                        <CheckBox x:Name="CopyDialogueBox" Content="Keep the line in Voicestudio" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#F4F1FF"/>
                    </StackPanel>
                    <Border Margin="0,14,0,0" Height="180" Background="#0E0C18" BorderBrush="#2C2748" BorderThickness="1" CornerRadius="12">
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    </Border>
                    <TextBox x:Name="OcrPreviewText" Margin="0,10,0,0" MinHeight="72" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="OCR text appears here."/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="ClearCacheButton" Style="{StaticResource QuietButton}" Content="Delete stored lines" Click="ClearCache_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="CacheStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#9B94B8"
                               Text="A new line waits until the current one finishes. A repeat with the same voice, pace, and model plays from %LOCALAPPDATA%\PaliaVoiceAI\cache."/>
                    <TextBlock x:Name="CaptureStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#C9C3E0"
                               Text="Use Preview to tune the region. The saved image is last-capture.bmp in %LOCALAPPDATA%\PaliaVoiceAI."/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#0E0C18" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinWidth="170">
                        <Grid Width="42" Height="42" Margin="0,0,10,0">
                            <local:Portrait x:Name="BottomPortrait" Width="42" Height="42"/>
                            <Ellipse x:Name="BottomAvatar" Width="42" Height="42" Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="BottomName" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BottomRole" Foreground="#9B94B8" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Margin="18,0" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Foreground="#C9C3E0"
                               Text="Ready. Pick a villager to preview the assigned voice. CPU downloads Kokoro once if it is not already on this PC."/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="HearYourselfBox" Style="{StaticResource Switch}" Content="Hear yourself" IsChecked="True" Checked="LibraryToggle_Changed" Unchecked="LibraryToggle_Changed"/>
                        <CheckBox x:Name="ApplyVoiceBox" Style="{StaticResource Switch}" Content="Apply voice" IsChecked="True" Checked="LibraryToggle_Changed" Unchecked="LibraryToggle_Changed"/>
                        <CheckBox x:Name="LiveCaptureBox" Style="{StaticResource Switch}" Content="Live capture" Checked="LiveCapture_Changed" Unchecked="LiveCapture_Changed"/>
                        <Button Style="{StaticResource ChromeButton}" Margin="8,0,0,0" Click="Stop_Click" ToolTip="Stop">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
