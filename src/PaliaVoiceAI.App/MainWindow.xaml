<Window x:Class="PaliaVoiceAI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Palia Voice AI" Height="760" Width="980"
        MinHeight="640" MinWidth="820" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Palia Voice AI" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Local dialogue capture, OCR, and the TTS benchmark pipeline" Foreground="Gray" Margin="0,4,0,12"/>
        </StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="Dialogue">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Backend" Margin="0,0,0,5"/>
                            <ComboBox x:Name="BackendBox" SelectedIndex="0">
                                <ComboBoxItem Content="Mock (pipeline test)"/>
                                <ComboBoxItem Content="CPU (Kokoro — not connected)"/>
                                <ComboBoxItem Content="CUDA (Kokoro — not connected)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Voice ID" Margin="0,0,0,5"/>
                            <ComboBox x:Name="VoiceBox" SelectedIndex="0">
                                <ComboBoxItem Content="af_bella"/>
                                <ComboBoxItem Content="af_nicole"/>
                                <ComboBoxItem Content="am_michael"/>
                                <ComboBoxItem Content="bm_george"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CPU Threads" Margin="0,0,0,5"/>
                            <ComboBox x:Name="ThreadsBox" SelectedIndex="1">
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="English dialogue" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="DialogueBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="16" Padding="12"
                             Text="Hello! Welcome to Kilima Village. How can I help you today?"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,8">
                        <Button x:Name="GenerateButton" Content="Generate / Benchmark" Width="170" Height="36" Click="Generate_Click"/>
                        <Button Content="Play" Width="80" Height="36" Margin="8,0,0,0" Click="Play_Click"/>
                        <Button Content="Stop" Width="80" Height="36" Margin="8,0,0,0" Click="Stop_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap" Foreground="DarkSlateGray"
                               Text="Ready. Mock mode produces silence and only verifies the pipeline. CPU and CUDA stay unavailable until Kokoro is connected."/>
                    <DataGrid x:Name="ResultsGrid" Grid.Row="5" Margin="0,12,0,0" AutoGenerateColumns="True" IsReadOnly="True"/>
                </Grid>
            </TabItem>
            <TabItem Header="Capture">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock TextWrapping="Wrap" Foreground="DimGray"
                                   Text="Reads the dialogue region with Windows OCR. A line is accepted only after it stays still, and the same line is not sent again inside the duplicate window. Game capture uses the Palia window. Manual capture copies an absolute screen rectangle."/>
                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <CheckBox x:Name="UseGameWindowBox" Content="Capture the Palia window" IsChecked="True" Checked="CaptureMode_Changed" Unchecked="CaptureMode_Changed"/>
                                <TextBlock x:Name="GameWindowStatus" Margin="0,8,0,0" TextWrapping="Wrap" Text="Palia has not been looked up yet."/>
                                <TextBlock x:Name="RegionHint" Margin="0,4,0,0" Foreground="Gray" Text="Region is relative to the Palia client area, in pixels."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="DetectButton" Content="Find Palia" Width="110" Height="32" Click="Detect_Click"/>
                                <Button x:Name="SuggestButton" Content="Suggest region" Width="120" Height="32" Margin="8,0,0,0" Click="Suggest_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="X"/><TextBox x:Name="RegionX" Margin="0,4,0,0" Text="131"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Y"/><TextBox x:Name="RegionY" Margin="0,4,0,0" Text="688"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Width"/><TextBox x:Name="RegionWidth" Margin="0,4,0,0" Text="975"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Height"/><TextBox x:Name="RegionHeight" Margin="0,4,0,0" Text="438"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                <TextBlock Text="Poll ms"/><TextBox x:Name="PollIntervalBox" Margin="0,4,0,0" Text="400"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5" Margin="0,0,8,0">
                                <TextBlock Text="Stable reads"/><TextBox x:Name="StableReadsBox" Margin="0,4,0,0" Text="2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Duplicate sec"/><TextBox x:Name="DuplicateWindowBox" Margin="0,4,0,0" Text="8"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="PreviewButton" Content="Preview once" Width="120" Height="34" Click="Preview_Click"/>
                            <Button x:Name="MonitorButton" Content="Start monitoring" Width="150" Height="34" Margin="8,0,0,0" Click="Monitor_Click"/>
                            <CheckBox x:Name="CopyDialogueBox" Content="Copy new dialogue into the text box" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Row="4" Margin="0,14,0,0" BorderBrush="#DDD" BorderThickness="1" Background="#FAFAFA">
                            <Image x:Name="PreviewImage" Stretch="Uniform"/>
                        </Border>
                        <TextBox x:Name="OcrPreviewText" Grid.Row="5" Margin="0,10,0,0" MinHeight="72" IsReadOnly="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"
                                 Text="OCR text appears here."/>
                        <TextBlock x:Name="CaptureStatus" Grid.Row="6" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkSlateGray"
                                   Text="Use Preview to tune the region. The saved image is last-capture.bmp in %LOCALAPPDATA%\PaliaVoiceAI."/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
